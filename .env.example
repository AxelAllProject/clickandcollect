# Copie ce fichier en ".env" (non versionné) et remplis tes propres valeurs.

DB_PASSWORD=postgres

JWT_SECRET=MaCleSecreteHyperLonguePourClickAndCollect123456789!

# Cles Stripe en mode test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Genere par `stripe listen --forward-to localhost:8080/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# URL du frontend (utilisee pour le lien de reinitialisation de mot de passe envoye par email)
FRONTEND_URL=http://localhost:5173

# Envoi d'emails (mot de passe oublie, code 2FA) via Gmail SMTP.
# MAIL_USERNAME = adresse Gmail dediee au projet.
# MAIL_APP_PASSWORD = mot de passe d'application genere sur https://myaccount.google.com/apppasswords
# (ne jamais utiliser le vrai mot de passe du compte Google ici)
MAIL_USERNAME=ton.adresse@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Client ID OAuth cree sur https://console.cloud.google.com/apis/credentials
# (le Client Secret n'est pas necessaire : la verification du jeton se fait via l'API publique de Google)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
